              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/user/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "user", "1"]
