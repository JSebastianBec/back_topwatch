# Copy to .env and fill in. Environment variables with the same name take precedence.
# Generate a key with: openssl rand -base64 32
JWT_SECRET=
DB_URL=jdbc:postgresql://localhost:5432/topwatch_db
DB_USERNAME=postgres
DB_PASSWORD=
# Optional, for image uploads
S3_BUCKET=topwatch-images
AWS_REGION=us-east-2
S3_PUBLIC_URL=https://topwatch-images.s3.us-east-2.amazonaws.com
